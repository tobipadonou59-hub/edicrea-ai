{
  "name": "EDICREA AI",
  "short_name": "EDICREA",
  "description": "Création graphique, mise en page et édition assistées par IA : livres, couvertures, affiches.",
  "lang": "fr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0c10",
  "theme_color": "#13161a",
  "categories": ["productivity", "graphics", "design", "books"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nouveau livre", "url": "/?new=book", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Nouvelle affiche", "url": "/?new=poster", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
